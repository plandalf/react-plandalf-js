{
  "name": "@plandalf/react-plandalf-js",
  "version": "0.1.6",
  "description": "Plandalf React JS library",
  "main": "dist/react-plandalf.js",
  "module": "dist/react-plandalf.esm.mjs",
  "jsnext:main": "dist/react-plandalf.esm.mjs",
  "browser:min": "dist/react-plandalf.umd.min.js",
  "browser": "dist/react-plandalf.umd.js",
  "types": "dist/react-plandalf.d.ts",
  "scripts": {
    "build": "rollup -c --bundleConfigAsCjs  && npm run checkimport",
    "dev": "rollup -c --bundleConfigAsCjs -w",
    "checkimport": "./check-imports"
  },
  "keywords": [
    "react",
    "Plandalf",
    "Payments"
  ],
  "author": "Plandalf (https://www.plandalf.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/plandalf/plandalf-js"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@plandalf/plandalf-js": "^0.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "resolutions": {
    "@types/react": "18.0.5"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.3.0 || ^17.0.0 || ^18.0.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.7.1",
    "@babel/preset-react": "^7.7.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.5",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup": "^4.12.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-ts": "^3.4.5",
    "ts-loader": "^6.2.1",
    "typescript": "^4.1.2"
  }
}
